{
  "name": "positron-stata",
  "displayName": "Stata Support for Positron",
  "description": "First-class Stata support for Positron IDE with native Variables, Data Explorer, Plots, and .dta support.",
  "version": "0.1.4",
  "publisher": "abhinavjnu",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhinavjnu/positron-stata"
  },
  "homepage": "https://github.com/abhinavjnu/positron-stata#readme",
  "bugs": {
    "url": "https://github.com/abhinavjnu/positron-stata/issues"
  },
  "keywords": [
    "stata",
    "econometrics",
    "statistics",
    "data-science",
    "positron"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Notebooks"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:stata",
    "onCustomEditor:positron-stata.dtaViewer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "stata",
        "aliases": [
          "Stata",
          "stata",
          "Do-file"
        ],
        "extensions": [
          ".do",
          ".ado",
          ".mata",
          ".ihlp",
          ".hlp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "stata",
        "scopeName": "source.stata",
        "path": "./syntaxes/stata.tmLanguage.json"
      }
    ],
    "languageRuntimes": [
      {
        "languageId": "stata"
      }
    ],
    "configuration": {
      "title": "Stata Support",
      "properties": {
        "positron-stata.stataHome": {
          "type": "string",
          "default": "",
          "description": "Path to the Stata installation directory (e.g. /usr/local/stata19, /Applications/StataNow 19, or C:\\Program Files\\Stata19). If blank, automatically discovered."
        },
        "positron-stata.stataEdition": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "mp",
            "se",
            "be"
          ],
          "enumDescriptions": [
            "Automatically detect highest installed edition (MP > SE > BE)",
            "Stata/MP (Multi-Processing / Parallel Edition)",
            "Stata/SE (Special Edition)",
            "Stata/BE (Basic Edition / Intercooled)"
          ],
          "description": "The Stata edition to initialize PyStata with."
        },
        "positron-stata.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python interpreter with PyStata installed. If blank, automatically detected from PATH or virtual environments."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "positron-stata.dtaViewer",
        "displayName": "Stata Data Explorer (.dta)",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.dta"
          },
          {
            "filenamePattern": "*.DTA"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "stata.runLineOrSelection",
        "title": "Execute Line or Selection in Stata",
        "category": "Stata"
      },
      {
        "command": "stata.doFile",
        "title": "Do File (Execute Current File in Stata)",
        "category": "Stata"
      },
      {
        "command": "stata.openDataExplorer",
        "title": "Open Current Dataset in Data Explorer",
        "category": "Stata"
      },
      {
        "command": "stata.openDtaInDataExplorer",
        "title": "Open in Data Explorer",
        "category": "Stata"
      }
    ],
    "keybindings": [
      {
        "command": "stata.doFile",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus && editorLangId == 'stata'"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "stata.openDtaInDataExplorer",
          "group": "navigation",
          "when": "resourceExtname == .dta || resourceExtname == .DTA"
        }
      ],
      "editor/context": [
        {
          "command": "workbench.action.positronConsole.executeCode",
          "group": "1_stata@1",
          "when": "editorLangId == 'stata'"
        },
        {
          "command": "stata.doFile",
          "group": "1_stata@2",
          "when": "editorLangId == 'stata'"
        },
        {
          "command": "stata.openDataExplorer",
          "group": "1_stata@3",
          "when": "editorLangId == 'stata'"
        }
      ],
      "editor/title/run": [
        {
          "command": "workbench.action.positronConsole.executeCode",
          "group": "navigation@0",
          "icon": "$(play)",
          "title": "Run Selection or Current Line",
          "when": "resourceLangId == 'stata' && !isInDiffEditor"
        },
        {
          "command": "stata.doFile",
          "group": "navigation@1",
          "icon": "$(run-all)",
          "title": "Do File (Execute Current File)",
          "when": "resourceLangId == 'stata' && !isInDiffEditor"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && esbuild tests/discovery.test.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=out/tests/discovery.test.js && node --test out/tests/discovery.test.js"
  },
  "devDependencies": {
    "@posit-dev/positron": "^0.2.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
